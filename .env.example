PORT=8787
PUBLIC_URL=http://localhost:8787
VITE_UMAMI_URL=http://localhost:3000
VITE_UMAMI_ID=
VITE_UMAMI_DOMAINS=
# GitHub App slug (github.com/apps/<slug>) and its bot user id, which is not the
# app id: run `gh api users/<slug>[bot] --jq .id`. The server uses the slug for
# the install link; the client bakes both in for the commit credit.
VITE_GITHUB_BOT_ID=
VITE_GITHUB_APP_SLUG=

# "Sign in with <provider>" on /connect (see docs/git-sync.md). Each provider
# is offered only when its credentials are set. Redirect URI for every app:
# PUBLIC_URL/api/oauth/callback.
# Required in production: key for the signed state cookie (e.g. openssl rand -hex 32)
SESSION_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITLAB_CLIENT_ID=
OAUTH_GITLAB_CLIENT_SECRET=
# Experimental, hidden unless OAUTH_BITBUCKET_ENABLED=true (not known to work yet)
# OAUTH_BITBUCKET_ENABLED=true
OAUTH_BITBUCKET_CLIENT_ID=
OAUTH_BITBUCKET_CLIENT_SECRET=
# Self-hosted instances, host -> credentials (JSON). Also available for GitLab.
# OAUTH_FORGEJO_INSTANCES={"codeberg.org":{"clientId":"...","clientSecret":"..."}}
# OAUTH_GITEA_INSTANCES={"git.example.org":{"clientId":"...","clientSecret":"..."}}

# Optional git CORS proxy (/api/git-proxy)
# Comma-separated host allowlist; empty allows any public host
GIT_PROXY_ALLOWED_HOSTS=
# Set to 1 to turn the proxy off
GIT_PROXY_DISABLED=
# Milliseconds one proxied request may take in total, body included (default 300000)
GIT_PROXY_DEADLINE_MS=
# Most bytes relayed from the git host per response (default 100000000)
GIT_PROXY_MAX_RESPONSE_BYTES=
# Set to 1 to also log each proxied git request's time to first byte, total
# time and sizes. Host and endpoint name only, never the repository path.
# Failed requests are always logged as method, host and status.
GIT_PROXY_TIMING=

# Optional: https URL of the CommitCV template repo. When set, the connect
# page offers "Create from the CommitCV template" (for attribution). Unset hides it.
VITE_TEMPLATE_REPO_URL=https://github.com/CommitCV/resume
# Codeberg's "create from template" page for the same template (has template_id)
VITE_CODEBERG_TEMPLATE_URL=
